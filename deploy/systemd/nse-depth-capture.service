[Unit]
Description=NSE order-book depth capture — one session, from the open to the close
Documentation=file:///home/opc/nse-algo-trader/docs/research/235_why_the_depth_capture_stopped.md
# The capture cannot start before the network is up, and network-online says only that the
# stack is ready — the recorder classifies its own feed failures, so nothing stronger is useful.
After=network-online.target
Wants=network-online.target

[Service]
# Simple, not oneshot: this runs for the whole session and ends itself at the close.
# `run_until_session_end` is what stops it, which is why no stop timer exists — and why
# `depth_capture_2026-08-11_run4` reached 15:30:13 unaided when nobody interfered (`A.118`).
Type=simple

# NO User=/Group=. This is a USER unit; the per-user manager already runs as opc and cannot
# setgid, which aborts the unit with 216/EXIT_GROUP before stdout is even opened. Learned on
# nse-daily-operations, where every firing died that way while looking installed.
WorkingDirectory=/home/opc/nse-algo-trader

# The three policy inputs the launcher deliberately refuses to default (`R.03`), stated here so
# an operator can see and change them without reading Python:
#   --retention-sessions 10      two trading weeks of tape. Bounded because the tape is the
#                                largest thing this project writes: ~1.3 GiB at 652 instruments
#                                and ~10 GiB at 9,000.
#   --disk-budget-fraction 0.30  of FREE disk, measured at start. 23 GiB free today, so about
#                                7 GiB — and the admission decision reports what that bought.
#   --minimum-coverage-fraction 0.9  the operator's own prior value, read from the 2026-08-12
#                                session reports rather than invented.
#   --only-on-trading-days       a timer fires on weekdays; only the exchange calendar knows
#                                which weekdays are holidays (`A.119`).
ExecStart=/home/opc/nse-algo-trader/.venv/bin/python -u scripts/record_live_depth_session.py \
    --only-on-trading-days \
    --retention-sessions 10 \
    --disk-budget-fraction 0.30 \
    --minimum-coverage-fraction 0.9

# SIGINT, not SIGTERM: both are handled identically by the launcher, and using the same signal a
# human sends keeps one code path. The generous stop timeout is what 2026-08-13 lacked — the
# capture was killed again while building its session report, and the tape lost its verdict.
KillSignal=SIGINT
TimeoutStopSec=300

# A shard writer dying mid-session must not cost the rest of the day. A clean exit at the close
# is a success and is never restarted; only a failure is.
Restart=on-failure
RestartSec=30

# Nothing may outlive the session it is recording. Seven hours covers 09:05 to the 15:30 close
# with room for the closing flush and the session report.
RuntimeMaxSec=25200

# Journald AND a file. The user journal on this host captures nothing from user units — measured
# on nse-daily-operations, where `journalctl --user` returned "No entries" while the unit was
# demonstrably running. The file is the one guaranteed to exist, and appending means a restart
# never erases the evidence of the run that failed.
StandardOutput=append:/home/opc/nse_archive/depth_capture_scheduled.log
StandardError=append:/home/opc/nse_archive/depth_capture_scheduled.log
SyslogIdentifier=nse-depth-capture

# Least privilege within what this layout permits. ProtectHome is deliberately NOT set: the venv
# interpreter and the project live under /home/opc, and ProtectHome=read-only makes systemd fail
# to locate the executable at all (203/EXEC). Measured on the sibling unit, not assumed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/opc/.nse_algo_trader /home/opc/nse_archive
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
# default.target, not multi-user.target — the latter does not exist in the user manager.
WantedBy=default.target
